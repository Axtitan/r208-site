# Postgres connection string — Neon free tier (https://neon.tech)
# Use the POOLED connection string (contains "-pooler" and "sslmode=require")
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/dbname?sslmode=require"

# Admin login password — REQUIRED, min 8 characters, no default exists.
# Changing it logs out every active session.
ADMIN_PASSWORD="change-me-to-something-long-and-random"

# Public site URL — used for sitemap.xml and robots.txt
SITE_URL="https://r208-site.vercel.app"
